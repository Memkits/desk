002,"t":"滩声才重新响起来"},{"s":246.726,"e":248.32043617021276,"t":"有了电，还得有粮"},{"s":248.32043617021276,"e":252.42041489361702,"t":"文澜河畔有一片叫美台洋的高地，五六千亩"},{"s":252.42041489361702,"e":254.47040425531915,"t":"因为长期内涝被抛荒"},{"s":254.47040425531915,"e":258.79815957446806,"t":"农业部门把它改造成方格田，排水和灌溉分渠"},{"s":258.79815957446806,"e":263.80924468085107,"t":"田边种防风林，第一期目标是一千五百亩高产稳产田"},{"s":263.80924468085107,"e":268.137,"t":"县城西门外的学田，也被改成了整齐的方格田"},{"s":268.737,"e":270.03828571428573,"t":"工业则往东搬"},{"s":270.03828571428573,"e":274.3759047619048,"t":"百仞城周边的土地大多是水田，污染也越来越重"},{"s":274.3759047619048,"e":278.4966428571429,"t":"于是从一六三零年起，钢铁和化工的大型基地"},{"s":278.4966428571429,"e":281.3160952380953,"t":"转到东边三面临海的马袅半岛"},{"s":281.3160952380953,"e":285.65371428571433,"t":"规划面积二十点五平方公里，自带一个天然港口"},{"s":285.65371428571433,"e":286.95500000000004,"t":"书里叫红牌港"},{"s":287.555,"e":292.80217241379313,"t":"临高钢铁公司在这里建起两座一百二十五立方米的高炉"},{"s":292.80217241379313,"e":296.0816551724138,"t":"每座十米高，旁边是同样高的热风炉"},{"s":296.0816551724138,"e":300.8915632183908,"t":"因为靠海，高炉外面还加了一圈抗台风的梁柱和锚索"},{"s":300.8915632183908,"e":304.82694252873563,"t":"今天，这片半岛上是临高金牌港经济开发区"},{"s":304.82694252873563,"e":306.576,"t":"依然是一片工业区"},{"s":308.976,"e":314.61209523809526,"t":"一六二九年四月，他们组织了一次环岛航行：从临高向西"},{"s":314.61209523809526,"e":318.0427619047619,"t":"经过儋州、昌化，绕到岛南的三亚湾"},{"s":318.0427619047619,"e":321.71847619047617,"t":"在崖州的榆林港，他们修筑了榆林堡"},{"s":321.71847619047617,"e":324.414,"t":"这里后来升格为三亚特区"},{"s":325.014,"e":329.8562647058824,"t":"另一支队伍沿着田独河逆流而上，找到了田独的铁矿"},{"s":329.8562647058824,"e":333.81811764705884,"t":"书里写这里的矿石品位很高，可以直接炼钢"},{"s":333.81811764705884,"e":338.4402794117647,"t":"后来修了一条榆林到田独的铁路，矿石从这里装船"},{"s":338.4402794117647,"e":339.981,"t":"运往马袅的高炉"},{"s":340.581,"e":346.2143968253968,"t":"一六三零年七月，明军从琼州府城出发，沿着驿道西进"},{"s":346.2143968253968,"e":351.8477936507937,"t":"双方在澄迈县城外的土堤一带交战，书里叫土堤之战"},{"s":351.8477936507937,"e":356.713,"t":"战后，穿越者的控制范围扩展到了整个海南岛"},{"s":359.113,"e":360.89336363636363,"t":"海南之后是珠江口"},{"s":360.89336363636363,"e":364.89918181818183,